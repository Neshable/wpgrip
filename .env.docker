# ────────────────────────────────────────────────────────────────────────────
# Docker-specific .env overrides
# Copy this to .env when running via docker compose.
# Only values that DIFFER from the base .env are listed here.
# ────────────────────────────────────────────────────────────────────────────

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# ── Database: use the mysql service name, not 127.0.0.1 ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel

# ── Redis: use the redis service name ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Use Redis for cache / sessions / queues ──
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ── Mail: point to Mailpit SMTP ──
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@wpgrip.test
MAIL_FROM_NAME="WPGrip"

# ── Logging ──
LOG_CHANNEL=stderr
LOG_LEVEL=debug
